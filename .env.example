# ═══════════════════════════════════════════
# 东方财富实盘选手爬虫 - 环境变量配置
# ═══════════════════════════════════════════
# 复制为 .env 并按需修改:
#   cp .env.example .env
# ═══════════════════════════════════════════

# ── 数据存储路径（默认在项目根目录 data/ logs/） ──
# CRAWL_DATA_DIR=/data/jiarenmens/data
# CRAWL_LOG_DIR=/data/jiarenmens/logs

# ── 并发与爬取参数 ──
# CRAWL_WORKERS=20          # 并发数 (默认 20)
# CRAWL_LIMIT=500           # 每榜单爬取数量 (默认 500)
# CRAWL_BATCH_SIZE=50       # 批量写入条数 (默认 50)
# CRAWL_CHECKPOINT_INTERVAL=50  # 检查点保存间隔 (默认 50)
# CRAWL_MAX_RETRIES=3       # 失败重试次数 (默认 3)

# ── 代理（国内腾讯云直连可不配） ──
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# SOCKS_PROXY=socks5://127.0.0.1:10808

# ── 自定义 User-Agent（一般不需要改） ──
# CRAWL_USER_AGENT="Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) ..."

# ── 实盘组合新接口会话（spzhapi.dfcfs.cn，2026-08 迁移后） ──
# 令牌会过期，过期后需在模拟器/手机 APP 中重新抓包获取
# SPZH_API_URL=https://spzhapi.dfcfs.cn/rtV3
# SPZH_CT_TOKEN=
# SPZH_UT_TOKEN=
# SPZH_USER_ID=
# SPZH_DEVICE_ID=
# SPZH_APP_VERSION=11.2.2
# SPZH_RN_VERSION=2.3.0.260731172423109
