# ═══════════════════════════════════════════════
# 生产环境配置 - 4核/4GB 腾讯云 Ubuntu
# ═══════════════════════════════════════════════
# 部署时复制为 .env:
#   cp .env.production .env
# ═══════════════════════════════════════════════

# ── 并发（4核建议 10-15，避免 Chromium 吃光内存） ──
CRAWL_WORKERS=10
CRAWL_LIMIT=500
CRAWL_BATCH_SIZE=50
CRAWL_CHECKPOINT_INTERVAL=50
CRAWL_MAX_RETRIES=3

# ── 国内腾讯云直连东方财富，不需要代理 ──
# HTTP_PROXY=
# HTTPS_PROXY=
